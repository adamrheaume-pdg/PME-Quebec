<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7FAFF">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pixel Cast Universal" android:textSize="30sp" android:textStyle="bold" android:textColor="#003DA5"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Partage ton écran vers un téléviseur ou écran sur le même Wi‑Fi." android:textSize="16sp" android:textColor="#263238"/>
    <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Démarrer le partage d’écran"/>
    <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Arrêter" android:enabled="false"/>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Prêt." android:textSize="16sp" android:textColor="#263238"/>
    <TextView android:id="@+id/urlText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true" android:textSize="18sp" android:textStyle="bold" android:textColor="#003DA5"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Sur la télé : ouvre le navigateur et entre l’adresse affichée." android:textSize="14sp" android:textColor="#455A64"/>
  </LinearLayout>
</ScrollView>
