<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/mq_bg"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:background="#FFFFFF">
        <ImageView android:layout_width="72dp" android:layout_height="72dp"
            android:src="@drawable/ic_launcher" android:contentDescription="Logo WiFi Québec"
            android:scaleType="fitCenter" android:adjustViewBounds="true"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WiFi Québec" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/mq_blue"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Réseau, analyse Wi-Fi et domotique locale" android:textSize="14sp" android:textColor="@color/mq_text"/>
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
            <Button android:id="@+id/btnScan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scanner le réseau" android:textColor="#FFFFFF" android:background="@drawable/button_primary"/>
            <Button android:id="@+id/btnAnalyzer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Analyse Wi-Fi"/>
            <Button android:id="@+id/btnDomotique" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Domotique"/>
            <Button android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Ajouter IP"/>
            <Button android:id="@+id/btnBell" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Borne Giga directe"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="8dp" android:text="Prêt" android:textColor="@color/mq_text"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/deviceList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"/>
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="24dp" android:background="#101418" />
</LinearLayout>
