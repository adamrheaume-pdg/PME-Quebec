<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Musique Québec</title>
<style>
:root{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color-scheme:dark;background:#0b0d10;color:#f7f8fa}
*{box-sizing:border-box}body{margin:0;background:#0b0d10;color:#f7f8fa}.app{max-width:720px;margin:auto;padding:18px 14px 40px}
h1{font-size:24px;margin:2px 0 4px}.muted{color:#aab1bd;font-size:13px}.card{background:#151922;border:1px solid #262d39;border-radius:18px;padding:14px;margin-top:14px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
input,textarea,select,button{font:inherit}input,textarea,select{width:100%;background:#0f131a;color:#fff;border:1px solid #303847;border-radius:12px;padding:11px}textarea{min-height:135px;resize:vertical}
.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1 1 130px}button{border:0;border-radius:12px;padding:11px 13px;background:#e8edf5;color:#111820;font-weight:800}button.primary{background:#5da9ff;color:#061523}button.danger{background:#3b2025;color:#ffb8c0}button.active{outline:2px solid #5da9ff}
#playerFrame{width:100%;height:100%;border:0;display:block}#playerWrap{width:100%;min-height:220px;aspect-ratio:16/9;background:#000;border-radius:14px;overflow:hidden;margin-top:12px}#player{width:100%;height:100%;min-height:220px}.controls{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:10px}.controls button{padding:12px 4px;font-size:18px}
.now{margin-top:10px;font-weight:800}.status{margin-top:8px;font-size:13px;color:#9ad0ff;min-height:18px}.tracklist{margin-top:10px;max-height:280px;overflow:auto;border-top:1px solid #2b3240}.track{display:flex;gap:10px;align-items:center;padding:10px 2px;border-bottom:1px solid #242a35;cursor:pointer}.track.current{color:#70b7ff}.track .n{width:28px;color:#8490a1}.track .t{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pill{display:inline-block;border:1px solid #3a4352;border-radius:999px;padding:5px 9px;font-size:12px;color:#cbd3df}
@media(max-width:480px){.controls{grid-template-columns:repeat(5,1fr)}.controls button{font-size:17px;padding:10px 2px}}
.brand{display:flex;align-items:center;gap:12px;margin:0 0 12px}.brand img{width:72px;height:72px;border-radius:18px;object-fit:cover;box-shadow:0 8px 24px #0008}.brand h1{margin:0;font-size:26px}
</style>
</head>
<body><main class="app">
<div class="brand"><img src="__LOGO_DATA__" alt="Musique Québec"><h1>Musique Québec</h1></div>
<div class="muted">Colle des liens YouTube directs, sauvegarde tes playlists et joue-les dans l’ordre ou en aléatoire.</div>

<section class="card">
<div class="row"><input id="playlistName" placeholder="Nom de la playlist"><select id="savedSelect"><option value="">Playlists sauvegardées…</option></select></div>
<div class="row" style="margin-top:8px"><button class="primary" onclick="savePlaylist()">💾 Sauvegarder</button><button onclick="loadSelected()">📂 Charger</button><button class="danger" onclick="deleteSelected()">🗑 Supprimer</button></div>
<textarea id="input" style="margin-top:10px" placeholder="Un lien par ligne, par exemple :\nhttps://youtu.be/dQw4w9WgXcQ\nhttps://www.youtube.com/watch?v=xxxxxxxxxxx"></textarea>
<div class="row" style="margin-top:8px"><button class="primary" onclick="importLinks()">➕ Importer la liste</button><button onclick="clearCurrent()">Vider</button></div>
<div id="importStatus" class="status"></div>
</section>

<section class="card">
<div class="row"><span id="modeLabel" class="pill">Ordre</span><span id="repeatLabel" class="pill">Répétition : non</span><span id="countLabel" class="pill">0 titre</span></div>
<div id="playerWrap"><div id="player"></div></div>
<div class="controls">
<button onclick="previousTrack()">⏮</button><button id="playBtn" onclick="togglePlay()">▶️</button><button onclick="nextTrack(true)">⏭</button><button id="shuffleBtn" onclick="toggleShuffle()">🔀</button><button id="repeatBtn" onclick="cycleRepeat()">🔁</button>
</div>
<div id="now" class="now">Aucun titre chargé</div><div id="playerStatus" class="status"></div>
<div id="trackList" class="tracklist"></div>
</section>

<section class="card"><div class="muted">Le lecteur YouTube est intégré directement dans Musique Québec avec une origine HTTPS valide. Les playlists sont enregistrées uniquement sur cet appareil. Les URL de recherche YouTube (<b>results?search_query=</b>) ne peuvent pas être jouées directement : utilise des liens <b>watch?v=</b>, <b>youtu.be</b>, <b>shorts</b> ou <b>embed</b>.</div></section>
</main>
<script src="https://www.youtube.com/iframe_api"></script>
<script>
let ready=false, tracks=[], index=0, shuffle=false, repeatMode=0, playing=false;
let player=null;
const APP_ORIGIN='https://musique-quebec.local';
function onYouTubeIframeAPIReady(){
  player=new YT.Player('player',{
    width:'100%',height:'100%',videoId:'',
    playerVars:{playsinline:1,rel:0,origin:APP_ORIGIN,widget_referrer:APP_ORIGIN+'/'},
    events:{
      onReady:()=>{ready=true;$('playerStatus').textContent='Lecteur YouTube intégré prêt.';if(tracks.length)loadCurrent(false)},
      onStateChange:onState,
      onError:onPlayerError
    }
  });
}
const STORAGE='yt_playlist_quebec_v1';
function $(id){return document.getElementById(id)}
function saved(){try{return JSON.parse(localStorage.getItem(STORAGE)||'{}')}catch(e){return {}}}
function writeSaved(v){localStorage.setItem(STORAGE,JSON.stringify(v));refreshSaved()}
function refreshSaved(){const s=$('savedSelect'), data=saved(), current=s.value;s.innerHTML='<option value="">Playlists sauvegardées…</option>';Object.keys(data).sort().forEach(k=>{const o=document.createElement('option');o.value=k;o.textContent=k+' ('+data[k].length+')';s.appendChild(o)});if(data[current])s.value=current}
function extractId(text){const patterns=[/youtu\.be\/([A-Za-z0-9_-]{11})/,/[?&]v=([A-Za-z0-9_-]{11})/,/youtube\.com\/shorts\/([A-Za-z0-9_-]{11})/,/youtube\.com\/embed\/([A-Za-z0-9_-]{11})/,/^([A-Za-z0-9_-]{11})$/];for(const p of patterns){const m=text.match(p);if(m)return m[1]}return null}
function importLinks(){const lines=$('input').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);const added=[];let rejected=0;for(const line of lines){const id=extractId(line);if(!id){rejected++;continue}const url='https://www.youtube.com/watch?v='+id;if(!tracks.some(t=>t.id===id))added.push({id:id,url:url,label:'Vidéo '+(tracks.length+added.length+1)})}tracks=tracks.concat(added);$('importStatus').textContent=added.length+' ajoutée(s)'+(rejected?' • '+rejected+' ligne(s) ignorée(s)':'');if(tracks.length===added.length&&tracks.length>0)index=0;render();if(ready&&tracks.length&&!player.getVideoData().video_id)loadCurrent(false)}
function clearCurrent(){tracks=[];index=0;if(player&&ready)player.stopVideo();render();$('input').value=''}
function savePlaylist(){const name=$('playlistName').value.trim();if(!name){$('importStatus').textContent='Entre un nom de playlist.';return}if(!tracks.length){$('importStatus').textContent='La playlist est vide.';return}const data=saved();data[name]=tracks;writeSaved(data);$('savedSelect').value=name;$('importStatus').textContent='Playlist « '+name+' » sauvegardée.'}
function loadSelected(){const name=$('savedSelect').value, data=saved();if(!name||!data[name])return;tracks=data[name];index=0;$('playlistName').value=name;render();if(ready&&tracks.length)loadCurrent(false)}
function deleteSelected(){const name=$('savedSelect').value;if(!name)return;const data=saved();delete data[name];writeSaved(data);$('importStatus').textContent='Playlist supprimée.'}
function onState(e){playing=e.data===YT.PlayerState.PLAYING;$('playBtn').textContent=playing?'⏸':'▶️';if(e.data===YT.PlayerState.ENDED){if(repeatMode===2){player.seekTo(0);player.playVideo()}else nextTrack(false)}if(e.data===YT.PlayerState.PLAYING){const d=player.getVideoData();if(d&&d.title){tracks[index].label=d.title;render()}}}
function onPlayerError(e){playing=false;$('playBtn').textContent='▶️';$('playerStatus').textContent=e.data===153?'Erreur 153 du lecteur intégré.':((e.data===101||e.data===150)?'Cette vidéo interdit la lecture intégrée.':'Erreur YouTube '+e.data+'.')}
function loadCurrent(autoplay=true){if(!ready||!tracks.length)return;index=Math.max(0,Math.min(index,tracks.length-1));$('playerStatus').textContent='';if(autoplay)player.loadVideoById(tracks[index].id);else player.cueVideoById(tracks[index].id);render()}
function togglePlay(){if(!ready||!tracks.length)return;if(playing)player.pauseVideo();else{const d=player.getVideoData();if(!d||!d.video_id)loadCurrent(true);else player.playVideo()}}
function nextTrack(manual){if(!tracks.length)return;if(shuffle&&tracks.length>1){let n=index;while(n===index)n=Math.floor(Math.random()*tracks.length);index=n}else if(index<tracks.length-1){index++}else if(repeatMode===1||shuffle){index=0}else{if(!manual){$('playerStatus').textContent='Fin de la playlist.';playing=false;$('playBtn').textContent='▶️';return}index=0}loadCurrent(true)}
function previousTrack(){if(!tracks.length)return;if(shuffle&&tracks.length>1){let n=index;while(n===index)n=Math.floor(Math.random()*tracks.length);index=n}else index=(index-1+tracks.length)%tracks.length;loadCurrent(true)}
function playAt(i){index=i;loadCurrent(true)}
function toggleShuffle(){shuffle=!shuffle;$('shuffleBtn').classList.toggle('active',shuffle);$('modeLabel').textContent=shuffle?'Aléatoire':'Ordre'}
function cycleRepeat(){repeatMode=(repeatMode+1)%3;const txt=['Répétition : non','Répéter tout','Répéter 1'];$('repeatLabel').textContent=txt[repeatMode];$('repeatBtn').classList.toggle('active',repeatMode>0)}
function render(){const list=$('trackList');list.innerHTML='';tracks.forEach((t,i)=>{const r=document.createElement('div');r.className='track'+(i===index?' current':'');r.onclick=()=>playAt(i);r.innerHTML='<span class="n">'+(i+1)+'</span><span class="t">'+escapeHtml(t.label||('Vidéo '+(i+1)))+'</span>';list.appendChild(r)});$('countLabel').textContent=tracks.length+' titre'+(tracks.length>1?'s':'');$('now').textContent=tracks.length?((index+1)+' / '+tracks.length+' — '+(tracks[index].label||('Vidéo '+(index+1)))):'Aucun titre chargé'}
function escapeHtml(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
refreshSaved();render();
</script>
<script id="pme-default-playlists-v2">
window.DEFAULT_PLAYLISTS={"global":[{"id":"VjfXV-xhDFk","url":"https://www.youtube.com/watch?v=VjfXV-xhDFk","label":"Kanlungan","artist":"Noel Cabangon","resolvedTitle":"Noel Cabangon performs \"Kanlungan\" live on Wish 107.5 Bus"},{"id":"_LN54uzeQo4","url":"https://www.youtube.com/watch?v=_LN54uzeQo4","label":"Heaven Knows (This Angel Has Flown)","artist":"Orange & Lemons","resolvedTitle":"Orange & Lemons - Heaven Knows (This Angel Has Flown) (Official Lyric Video)"},{"id":"OUFuaMj6z-w","url":"https://www.youtube.com/watch?v=OUFuaMj6z-w","label":"Beautiful Scars","artist":"Maximillian","resolvedTitle":"Maximillian - Beautiful Scars (Official Video)"},{"id":"Jtauh8GcxBY","url":"https://www.youtube.com/watch?v=Jtauh8GcxBY","label":"Before You Go","artist":"Lewis Capaldi","resolvedTitle":"Lewis Capaldi - Before You Go (Official Video)"},{"id":"nCkpzqqog4k","url":"https://www.youtube.com/watch?v=nCkpzqqog4k","label":"I'm Not the Only One","artist":"Sam Smith","resolvedTitle":"Sam Smith - I'm Not The Only One (Official Music Video)"},{"id":"7JK7NTqMWcs","url":"https://www.youtube.com/watch?v=7JK7NTqMWcs","label":"Don't Know What to Do","artist":"Ric Segreto","resolvedTitle":"Ric Segreto — Don't Know What To Do | ORIGINAL VERSION [Official Lyric Video]"},{"id":"ZmDBbnmKpqQ","url":"https://www.youtube.com/watch?v=ZmDBbnmKpqQ","label":"drivers license","artist":"Olivia Rodrigo","resolvedTitle":"Olivia Rodrigo - drivers license (Official Video)"},{"id":"cRi-x2r88no","url":"https://www.youtube.com/watch?v=cRi-x2r88no","label":"Here's Your Perfect","artist":"Jamie Miller","resolvedTitle":"Jamie Miller - Here's Your Perfect (Official Music Video)"},{"id":"tQ0yjYUFKAE","url":"https://www.youtube.com/watch?v=tQ0yjYUFKAE","label":"Peaches","artist":"Justin Bieber ft. Daniel Caesar & Giveon","resolvedTitle":"Justin Bieber - Peaches ft. Daniel Caesar, Giveon"},{"id":"xQOO2xGQ1Pc","url":"https://www.youtube.com/watch?v=xQOO2xGQ1Pc","label":"Lonely","artist":"Justin Bieber & benny blanco","resolvedTitle":"Justin Bieber & benny blanco - Lonely (Official Music Video)"},{"id":"1EmF8m5s22Y","url":"https://www.youtube.com/watch?v=1EmF8m5s22Y","label":"Pag-Ibig","artist":"Sponge Cola","resolvedTitle":"Sponge Cola performs \"Pag-ibig\" LIVE on Wish 107.5 Bus"},{"id":"Ia4RPXAh4J0","url":"https://www.youtube.com/watch?v=Ia4RPXAh4J0","label":"Walang Iba","artist":"Ezra Band","resolvedTitle":"Ezra Band - Walang Iba(Lyrics)"},{"id":"rbKxoz1ZfiM","url":"https://www.youtube.com/watch?v=rbKxoz1ZfiM","label":"Bagsakan","artist":"Parokya ni Edgar ft. Francis M. & Gloc-9","resolvedTitle":"Parokya ni Edgar feat. Francis M and Gloc-9 - Bagsakan (Official Music Video)"},{"id":"25Cs__vdmII","url":"https://www.youtube.com/watch?v=25Cs__vdmII","label":"Paubaya","artist":"Moira Dela Torre","resolvedTitle":"Moira Dela Torre - Paubaya | Official Music Video | feat. Joshua Garcia & Julia Barretto"},{"id":"GX3X9PmQOHY","url":"https://www.youtube.com/watch?v=GX3X9PmQOHY","label":"Umaasa","artist":"Calein","resolvedTitle":"Calein - Umaasa (Official Lyric Video)"},{"id":"RX3BaiUZqYU","url":"https://www.youtube.com/watch?v=RX3BaiUZqYU","label":"Teka Lang","artist":"Emman Nimedez","resolvedTitle":"EMMAN - Teka Lang (Official Lyric Video)"},{"id":"K_zylJH4PRI","url":"https://www.youtube.com/watch?v=K_zylJH4PRI","label":"At My Worst","artist":"Pink Sweat$","resolvedTitle":"Pink Sweat$ - At My Worst (feat. Kehlani) [Official Video]"},{"id":"uWRlisQu4fo","url":"https://www.youtube.com/watch?v=uWRlisQu4fo","label":"Heartbreak Anniversary","artist":"Giveon","resolvedTitle":"GIVĒON - Heartbreak Anniversary (Official Music Video)"},{"id":"yctQRe--q6c","url":"https://www.youtube.com/watch?v=yctQRe--q6c","label":"Love Is Gone","artist":"SLANDER ft. Dylan Matthew","resolvedTitle":"SLANDER - Love Is Gone (ft. Dylan Matthew) [Official Music Video]"},{"id":"BYJ23QAx_L8","url":"https://www.youtube.com/watch?v=BYJ23QAx_L8","label":"Marikit","artist":"Juan Caoile & Kyle","resolvedTitle":"Juan and Kyle - Marikit (Official Music Video)"},{"id":"nSKqzEoEv_E","url":"https://www.youtube.com/watch?v=nSKqzEoEv_E","label":"Paalam","artist":"Moira Dela Torre & Ben&Ben","resolvedTitle":"Paalam - Moira Dela Torre x Ben&Ben (Music Video)"},{"id":"GQo2FerStNA","url":"https://www.youtube.com/watch?v=GQo2FerStNA","label":"Chill Lang","artist":"James Reid","resolvedTitle":"Randomantic (Live at The Cozy Cove) - James Reid"},{"id":"rGJTcd3JHWw","url":"https://www.youtube.com/watch?v=rGJTcd3JHWw","label":"Dance With You","artist":"Skusta Clee ft. Yuri Dope","resolvedTitle":"Dance With You - Skusta Clee ft. Yuri Dope (Prod. by Flip-D) (Official Music Video)"},{"id":"ndY9yaSwnxM","url":"https://www.youtube.com/watch?v=ndY9yaSwnxM","label":"Make It With You","artist":"Bread","resolvedTitle":"Make It with You"},{"id":"WerQABDxisM","url":"https://www.youtube.com/watch?v=WerQABDxisM","label":"Imahe","artist":"Magnus Haven","resolvedTitle":"Magnus Haven - Imahe (Official Lyric Video)"},{"id":"BWf-eARnf6U","url":"https://www.youtube.com/watch?v=BWf-eARnf6U","label":"Heal the World","artist":"Michael Jackson","resolvedTitle":"Michael Jackson - Heal The World (Official Video)"},{"id":"dglBgJSMr-E","url":"https://www.youtube.com/watch?v=dglBgJSMr-E","label":"Raining in Manila","artist":"Lola Amour","resolvedTitle":"Lola Amour - Raining in Manila (Official Lyric Video)"},{"id":"pfxyk1glEq4","url":"https://www.youtube.com/watch?v=pfxyk1glEq4","label":"Under the Influence","artist":"Chris Brown","resolvedTitle":"Chris Brown - Under The Influence (Official Video)"},{"id":"GlPlfCy1urI","url":"https://www.youtube.com/watch?v=GlPlfCy1urI","label":"Your Song","artist":"Elton John","resolvedTitle":"Elton John - Your Song (Top Of The Pops 1971)"},{"id":"JuXzxioHOCM","url":"https://www.youtube.com/watch?v=JuXzxioHOCM","label":"Hindi Tayo Pwede","artist":"The Juans","resolvedTitle":"The Juans - Hindi Tayo Pwede (Official Audio)"},{"id":"S2Cti12XBw4","url":"https://www.youtube.com/watch?v=S2Cti12XBw4","label":"Sunday Morning","artist":"Maroon 5","resolvedTitle":"Maroon 5 - Sunday Morning"},{"id":"8xg3vE8Ie_E","url":"https://www.youtube.com/watch?v=8xg3vE8Ie_E","label":"Love Story","artist":"Taylor Swift","resolvedTitle":"Taylor Swift - Love Story"},{"id":"F-cO2CMue4Q","url":"https://www.youtube.com/watch?v=F-cO2CMue4Q","label":"It's You","artist":"Ali Gatie","resolvedTitle":"Ali Gatie - It's You [Official Music Video]"},{"id":"NdYWuo9OFAw","url":"https://www.youtube.com/watch?v=NdYWuo9OFAw","label":"Iris","artist":"Goo Goo Dolls","resolvedTitle":"Goo Goo Dolls – Iris [Official Music Video] [4K Remaster]"},{"id":"50VWOBi0VFs","url":"https://www.youtube.com/watch?v=50VWOBi0VFs","label":"Jealous","artist":"Labrinth","resolvedTitle":"Labrinth - Jealous (Official Video)"},{"id":"TjEbuWP3hjg","url":"https://www.youtube.com/watch?v=TjEbuWP3hjg","label":"Tadhana","artist":"Up Dharma Down","resolvedTitle":"Tadhana - Up Dharma Down (Official Lyric Video)"},{"id":"lY2yjAdbvdQ","url":"https://www.youtube.com/watch?v=lY2yjAdbvdQ","label":"Treat You Better","artist":"Shawn Mendes","resolvedTitle":"Shawn Mendes - Treat You Better"},{"id":"xVhs4gezmGY","url":"https://www.youtube.com/watch?v=xVhs4gezmGY","label":"A Million Dreams","artist":"Ziv Zaifman, Hugh Jackman & Michelle Williams","resolvedTitle":"The Greatest Showman - A Million Dreams [Lyrics] (Hugh Jackman, Michelle Ingrid, Ziv Zaifman)"},{"id":"F2AitTPI5U0","url":"https://www.youtube.com/watch?v=F2AitTPI5U0","label":"Black or White","artist":"Michael Jackson","resolvedTitle":"Michael Jackson - Black Or White (Official Video - Shortened Version)"},{"id":"oyEuk8j8imI","url":"https://www.youtube.com/watch?v=oyEuk8j8imI","label":"Love Yourself","artist":"Justin Bieber","resolvedTitle":"Justin Bieber - Love Yourself (PURPOSE : The Movement)"},{"id":"uelHwf8o7_U","url":"https://www.youtube.com/watch?v=uelHwf8o7_U","label":"Love the Way You Lie","artist":"Eminem ft. Rihanna","resolvedTitle":"Eminem - Love The Way You Lie ft. Rihanna"},{"id":"Scq65uGROKk","url":"https://www.youtube.com/watch?v=Scq65uGROKk","label":"Rewrite the Stars","artist":"Zac Efron & Zendaya","resolvedTitle":"The Greatest Showman Lyric Video - Rewrite the Stars (2018) | FandangoNOW Extras"},{"id":"PIh2xe4jnpk","url":"https://www.youtube.com/watch?v=PIh2xe4jnpk","label":"Rude","artist":"MAGIC!","resolvedTitle":"MAGIC! - Rude (Official Video)"},{"id":"Sv6dMFF_yts","url":"https://www.youtube.com/watch?v=Sv6dMFF_yts","label":"We Are Young","artist":"fun. ft. Janelle Monáe","resolvedTitle":"Fun.: We Are Young ft. Janelle Monáe [OFFICIAL VIDEO]"},{"id":"N8JjVe8lMjI","url":"https://www.youtube.com/watch?v=N8JjVe8lMjI","label":"This Is the Moment","artist":"Anthony Warlow","resolvedTitle":"THIS IS THE MOMENT - Anthony Warlow"},{"id":"450p7goxZqg","url":"https://www.youtube.com/watch?v=450p7goxZqg","label":"All of Me","artist":"John Legend","resolvedTitle":"John Legend - All of Me (Official Video)"},{"id":"DhtYllyLx9w","url":"https://www.youtube.com/watch?v=DhtYllyLx9w","label":"Having You Near Me","artist":"Air Supply","resolvedTitle":"Air Supply - Having You Near Me (lyrics)"},{"id":"d5vYn6m934Y","url":"https://www.youtube.com/watch?v=d5vYn6m934Y","label":"Too Much Love Will Kill You","artist":"Brian May","resolvedTitle":"Brian May - Too Much Love Will Kill You (Official Video Remastered)"},{"id":"HPR-VwzbDRg","url":"https://www.youtube.com/watch?v=HPR-VwzbDRg","label":"In the Stars","artist":"Benson Boone","resolvedTitle":"Benson Boone - In The Stars (Official Music Video)"},{"id":"-FyjEnoIgTM","url":"https://www.youtube